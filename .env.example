# Copy to .env for local development. In production these are Fly secrets,
# except ENVIRONMENT/DATABASE_PATH/STATIC_DIR which live in fly.toml.

ENVIRONMENT=development

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production

# Web logins. admin can read; superadmin can also add and load competitions.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=change-me-too

# Optional. Enables `Authorization: Bearer <key>` access for scripts, with the
# superadmin role. Leave unset to disable API key access entirely.
# API_KEY=

# Optional overrides.
# DATABASE_PATH=data/wmf_scraper.db
# STATIC_DIR=static
